# Copy to .env and adjust, then run: docker compose --env-file .env up -d

# URL of the llama-server backend to proxy (REQUIRED)
LLAMA_SERVER_URL=http://192.168.0.9:8080

# Enable automatic safety pre-flight screening on chat requests
RUBICK_AUTO_GUARDIAN=false

# Enable transparent intent auto-routing (Decision / Embedding head hijacking)
RUBICK_INTENT_PARSER=true

# Attach natural language explanations to hijacked decisions on /v1/chat/completions
RUBICK_EXPLAIN=true

# Backend request timeout in seconds
RUBICK_TIMEOUT=60.0

# Host port to publish (container always listens on 8000 internally)
RUBICK_PORT=8000
